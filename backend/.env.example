# Supabase Configuration
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_SERVICE_KEY=your-service-role-key-here

# JWT Secret (use a long random string)
JWT_SECRET=your-super-secret-jwt-key-change-this-in-production

# Server
PORT=5000
NODE_ENV=development

# Scraper Settings
SCRAPE_INTERVAL_HOURS=3
HEADLESS=true

# ── Email Notifications (optional but recommended) ──────────────────
# When set, admin receives an email when someone registers.
# Approved/rejected users also receive notification emails.
#
# How to get Gmail App Password:
#   1. Go to myaccount.google.com → Security → 2-Step Verification (enable it)
#   2. Then go to myaccount.google.com/apppasswords
#   3. Create an app password for "Mail" → copy the 16-char password
#
ADMIN_EMAIL=your-admin-email@gmail.com
EMAIL_USER=your-gmail@gmail.com
EMAIL_PASS=your-gmail-app-password-here

# Optional: Frontend URL for CORS
# FRONTEND_URL=https://your-frontend-domain.com
